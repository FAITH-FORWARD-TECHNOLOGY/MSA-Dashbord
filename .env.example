# Configuration du dashboard MSA — copier en .env (ou .env.local)
# et remplir selon l'environnement cible.
#
# Lu via import.meta.env dans Vite, centralisé dans src/backoffice/config/api.js.

# URL de l'API NestJS.
#   - PROD  : https://api-pr.mydigifinance.com  (dashboard hébergé sur msa-pr.mydigifinance.com)
#   - PP    : https://api-msa.mydigifinance.com (environnement de test/preprod historique)
#   - LOCAL : http://localhost:3000 (déjà géré par `npm run dev:local`)
VITE_API_URL=https://api-msa.mydigifinance.com
